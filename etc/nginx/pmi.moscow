# nginx-proxy: copy to vhost.d/pmi.moscow (reload nginx-proxy).
#
# REQUIRED bind mounts in rproxy/docker-compose.yml (see etc/nginx/docker-compose.rproxy.example.yml):
#   /home/toptuk/pmi.moscow/frontend/static  -> /home/club/frontend/static:ro
#   /home/toptuk/pmi.moscow/gdpr/downloads   -> /home/club/gdpr/downloads:ro
#
# Without these mounts nginx looks inside the container at /home/club/frontend/static
# and returns 404 even when files exist on the host under pmi.moscow/frontend/static.

charset utf-8;
client_max_body_size 30M;
index index.html index.htm;

set_real_ip_from  172.17.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

rewrite ^/favicon.ico$ https://pmi.moscow/static/images/favicon/favicon.ico;
rewrite ^/favicon.png$ https://pmi.moscow/static/images/favicon/favicon-32x32.png;

location /static/ {
    root /home/club/frontend;
    gzip_static on;
    expires     max;
    add_header Cache-Control "public";
}

location /downloads/ {
    root /home/club/gdpr/;
    gzip_static off;
    expires     max;
    add_header Cache-Control "public";
}
